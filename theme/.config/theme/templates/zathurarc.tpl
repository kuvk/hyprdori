# {{ theme_name }}, generated by hyprdori-theme-set
# Colors and font for zathura, included by ~/.config/zathura/zathurarc. The font is the terminals'
# (Settings > Fonts) at the GTK apps' size (Displays > Text size).
set font "{{ nerd_font }} {{ gtk_font_pt }}"

set default-bg "{{ background }}"
set default-fg "{{ foreground }}"

set statusbar-bg "{{ background }}"
set statusbar-fg "{{ accent }}"
set inputbar-bg "{{ background }}"
set inputbar-fg "{{ orange }}"

set notification-bg "{{ background }}"
set notification-fg "{{ foreground }}"
set notification-error-bg "{{ background }}"
set notification-error-fg "{{ red }}"
set notification-warning-bg "{{ background }}"
set notification-warning-fg "{{ yellow }}"

set completion-bg "{{ dark_background }}"
set completion-fg "{{ foreground }}"
set completion-group-bg "{{ darker_background }}"
set completion-group-fg "{{ accent }}"
set completion-highlight-bg "{{ selection }}"
set completion-highlight-fg "{{ accent }}"

set index-bg "{{ background }}"
set index-fg "{{ foreground }}"
set index-active-bg "{{ selection }}"
set index-active-fg "{{ accent }}"

set render-loading-bg "{{ background }}"
set render-loading-fg "{{ muted }}"

# search results, the current one, and the link hints' text
set highlight-color "rgba({{ accent.rgb }}, 0.5)"
set highlight-active-color "rgba({{ orange.rgb }}, 0.5)"
set highlight-fg "{{ background }}"

# Ctrl+R: pages in the theme's colors
set recolor-lightcolor "{{ background }}"
set recolor-darkcolor "{{ foreground }}"

set signature-success-color "rgba({{ green.rgb }}, 0.5)"
set signature-warning-color "rgba({{ yellow.rgb }}, 0.5)"
set signature-error-color "rgba({{ red.rgb }}, 0.5)"
