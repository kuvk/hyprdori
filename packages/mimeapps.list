# What opens what, on a fresh install: install.sh copies this to ~/.config/mimeapps.list when
# there is none, and the file is the machine's own from then on (apps and xdg-settings write to
# it; hyprdori-browser set changes the browser). Every app named here is in packages/core.txt,
# but LibreOffice.
[Default Applications]
# The web: the default browser
text/html=chromium.desktop
x-scheme-handler/http=chromium.desktop
x-scheme-handler/https=chromium.desktop
x-scheme-handler/about=chromium.desktop
x-scheme-handler/unknown=chromium.desktop
# Images: swayimg
image/bmp=swayimg.desktop
image/gif=swayimg.desktop
image/jpeg=swayimg.desktop
image/jpg=swayimg.desktop
image/pjpeg=swayimg.desktop
image/png=swayimg.desktop
image/x-png=swayimg.desktop
image/svg+xml=swayimg.desktop
image/tiff=swayimg.desktop
image/webp=swayimg.desktop
image/avif=swayimg.desktop
image/heif=swayimg.desktop
image/jxl=swayimg.desktop
image/x-bmp=swayimg.desktop
image/x-tga=swayimg.desktop
image/x-targa=swayimg.desktop
image/x-exr=swayimg.desktop
image/pbm=swayimg.desktop
image/x-portable-bitmap=swayimg.desktop
image/x-portable-graymap=swayimg.desktop
image/x-portable-pixmap=swayimg.desktop
image/x-portable-anymap=swayimg.desktop
image/vnd.microsoft.icon=swayimg.desktop
image/x-icns=swayimg.desktop
image/x-win-bitmap=swayimg.desktop
image/x-xbitmap=swayimg.desktop
image/x-xpixmap=swayimg.desktop
image/x-pcx=swayimg.desktop
image/vnd.zbrush.pcx=swayimg.desktop
# Folders: yazi in kitty (local/.local/share/applications/yazi.desktop); with none set, the first
# app listing folders opens them, kitty's open handler
inode/directory=yazi.desktop
# PDFs, PostScript, DjVu, comic books: zathura
application/pdf=org.pwmt.zathura.desktop
application/postscript=org.pwmt.zathura.desktop
application/djvu=org.pwmt.zathura.desktop
application/vnd.comicbook+zip=org.pwmt.zathura.desktop
application/vnd.comicbook-rar=org.pwmt.zathura.desktop
# Video and sound: VLC
video/mp4=vlc.desktop
video/x-matroska=vlc.desktop
video/webm=vlc.desktop
video/quicktime=vlc.desktop
video/x-msvideo=vlc.desktop
video/avi=vlc.desktop
video/msvideo=vlc.desktop
video/x-avi=vlc.desktop
video/mpeg=vlc.desktop
video/x-mpeg=vlc.desktop
video/x-mpeg2=vlc.desktop
video/mpeg-system=vlc.desktop
video/x-mpeg-system=vlc.desktop
video/mp2t=vlc.desktop
video/mp4v-es=vlc.desktop
video/x-m4v=vlc.desktop
video/ogg=vlc.desktop
video/x-ogm=vlc.desktop
video/x-ogm+ogg=vlc.desktop
video/x-theora=vlc.desktop
video/x-theora+ogg=vlc.desktop
video/3gp=vlc.desktop
video/3gpp=vlc.desktop
video/3gpp2=vlc.desktop
video/x-flv=vlc.desktop
video/flv=vlc.desktop
video/x-ms-wmv=vlc.desktop
video/x-ms-asf=vlc.desktop
video/x-ms-asf-plugin=vlc.desktop
video/x-ms-asx=vlc.desktop
video/x-ms-wm=vlc.desktop
video/x-ms-wmx=vlc.desktop
video/x-ms-wvx=vlc.desktop
video/divx=vlc.desktop
video/vnd.divx=vlc.desktop
video/dv=vlc.desktop
video/fli=vlc.desktop
video/x-fli=vlc.desktop
video/x-flc=vlc.desktop
video/x-anim=vlc.desktop
video/x-nsv=vlc.desktop
video/vnd.mpegurl=vlc.desktop
video/vnd.rn-realvideo=vlc.desktop
audio/mpeg=vlc.desktop
audio/mp4=vlc.desktop
audio/aac=vlc.desktop
audio/flac=vlc.desktop
audio/x-flac=vlc.desktop
audio/ogg=vlc.desktop
audio/x-vorbis+ogg=vlc.desktop
audio/opus=vlc.desktop
audio/x-opus+ogg=vlc.desktop
audio/x-wav=vlc.desktop
audio/wav=vlc.desktop
audio/x-m4a=vlc.desktop
audio/x-ms-wma=vlc.desktop
audio/webm=vlc.desktop
audio/x-matroska=vlc.desktop
# Office files: LibreOffice (packages/apps.txt, optional; without it these open with whatever
# else claims them)
# documents: Word, OpenDocument text, RTF
application/msword=libreoffice-writer.desktop
application/rtf=libreoffice-writer.desktop
application/vnd.lotus-wordpro=libreoffice-writer.desktop
application/vnd.ms-word=libreoffice-writer.desktop
application/vnd.ms-word.document.macroEnabled.12=libreoffice-writer.desktop
application/vnd.ms-word.template.macroEnabled.12=libreoffice-writer.desktop
