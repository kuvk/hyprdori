#!/usr/bin/env bash
# Single window: a lone tiled window keeps a set shape and doesn't fill the screen. The shape
# is in ~/.config/hypr/configs/single-window.lua (layout:single_window_aspect_ratio).
# SUPER+SHIFT+S turns it on and off; it stays as left across
# reloads and restarts (hyprland.lua loads the file while the flag exists).
#
#   hyprdori-single-window          on, or off if on
#   hyprdori-single-window on|off

# -h, --help: the comment above, then nothing else runs
case ${1:-} in -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac
set -euo pipefail

FLAG="$HOME/.local/state/hyprdori/single-window"

# on the on-screen display, for a moment
osd() { "$HOME/.local/bin/hyprdori-osd" box "$1"; }

on() {
    mkdir -p "${FLAG%/*}"
    touch "$FLAG"
    # the file itself, as hyprland.lua loads it (pasted, its "--" comments read as flags)
    hyprctl eval "package.loaded['configs.single-window'] = nil; require('configs.single-window')" >/dev/null
    osd "Single window on"
}

off() {
    rm -f "$FLAG"
    # Hyprland's default: fill the screen
    hyprctl eval "hl.config({ layout = { single_window_aspect_ratio = { 0, 0 } } })" >/dev/null
    osd "Single window off"
}

case ${1:-toggle} in
    toggle) [[ -e $FLAG ]] && off || on ;;
    on) on ;;
    off) off ;;
    *)
        echo "usage: hyprdori-single-window [on|off]" >&2
        exit 1
        ;;
esac
