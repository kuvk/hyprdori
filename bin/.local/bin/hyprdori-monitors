#!/usr/bin/env python3
"""Monitor layouts per setup, with workspaces and text size. Brightness isn't part of a
setup: it's read from and set on the screen itself (backlight, or DDC/CI), which keeps it.

Each combination of connected monitors (home dock, office, laptop alone, ...)
gets its own profile in ~/.config/hypr/monitors.json. Monitors are matched by
their EDID description, not the port, so a profile survives a different cable
or dock. The first time a setup is seen its profile is created from the
current live layout, and workspaces are split across the monitors.

  hyprdori-monitors [apply]              apply the profile for the connected monitors
  hyprdori-monitors hotplug              same, from Hyprland's monitor.added/removed events
                                        (while the screen is locked, once it's unlocked)
  hyprdori-monitors startup              same, at login (waits for late outputs)
  hyprdori-monitors lid                  the lid opened or closed: apply again (clamshell)
  hyprdori-monitors state                print the current profile as JSON (Quickshell)
  hyprdori-monitors set '<json>'         save and apply changes from Quickshell
  hyprdori-monitors reset                this setup as if it were new (Displays > Defaults)
  hyprdori-monitors export-greeter       save the monitor layout for the login screen
  hyprdori-monitors brightness           print brightness per monitor as JSON
  hyprdori-monitors brightness NAME PCT  set brightness (backlight or DDC/CI)

Workspaces by default: the primary monitor gets 1-5, a second monitor 6-10,
with three monitors 3 each (1-3 on the primary). Any workspace can be
assigned or left unassigned in Displays (the bar's dropdown, or Settings).

Per monitor also: variable refresh rate (off by default: turning it on and off at
fullscreen blanks some screens for a moment) and the color mode: sRGB, or the panel's
own colors from its EDID (wide-gamut screens).

No HDR: every rule has supports_hdr = -1. Otherwise Hyprland sends HDR metadata to an HDR
screen even in SDR, and some screens (the Samsung Odyssey G50F) reconnect on it.

Color depth: 10-bit by default where the screen takes it (its EDID: the color depth, or an
HDMI screen's deep color flags), else 8.

Text size is in px (9-20, default 12): it
sets the shell font, GTK's font size (hyprdori-theme-set --text-size) and kitty's
font size.
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

# The parts are beside the commands, in ../lib/hyprdori (the repo's bin/.local/lib/hyprdori)
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib/hyprdori"))

from monitors_apply import apply, export_greeter_layout, reset, set_state, state
from monitors_base import DUPLICATES, live_monitors, log
from monitors_brightness import brightness_get, brightness_set
from monitors_events import hotplug, lid
from monitors_profiles import current_profile, load_profiles, profile_key


def main(argv: list[str]) -> int:
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv and argv[0] in ("hotplug", "startup"):
        return hotplug(startup=argv[0] == "startup")
    if argv == ["lid"]:
        return lid()
    live = live_monitors()
    if not live:
        print("hyprctl monitors returned nothing; is Hyprland running?", file=sys.stderr)
        return 1
    descs = [(m.get("description") or "").strip() for m in live]
    DUPLICATES.update(d for d in descs if d and descs.count(d) > 1)
    data = load_profiles()
    cmd = argv[0] if argv else "apply"

    if cmd == "apply":
        log(f"apply: profile '{profile_key(live)}'")
        apply(data, live, force_reload="--reload" in argv)
    elif cmd == "export-greeter":
        export_greeter_layout(current_profile(data, live)[1], live)
    elif cmd == "state":
        print(json.dumps(state(data, live)))
    elif cmd == "set" and len(argv) > 1:
        set_state(data, live, json.loads(argv[1]))
    elif cmd == "reset":
        log(f"reset: profile '{profile_key(live)}'")
        reset(data, live)
    elif cmd == "brightness" and len(argv) == 1:
        print(json.dumps(brightness_get(live)))
    elif cmd == "brightness" and len(argv) == 3:
        brightness_set(argv[1], int(float(argv[2])))
    else:
        print(__doc__.strip())
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
