#!/usr/bin/env bash
# Mode: Default, or one of two modes on top of it:
#   Work  no animations, blur or rounding; Quickshell goes opaque with the Work and Game gaps,
#         and live wallpapers pause
#   Game  the same, plus a plain US keyboard (Alt and Super not swapped, as input.lua
#         does, and no layout switching) so games get the printed keys, and Stay Awake
#
#   hyprdori-mode work     Work mode, or back to Default if already in it (SUPER+G)
#   hyprdori-mode game     Game mode, or back to Default if already in it (SUPER+CTRL+G)
#   hyprdori-mode cycle    Default, Work, Game, Default (the bar and Control Center)
#   hyprdori-mode default  back to Default from either mode
#   hyprdori-mode restyle  the mode's look again (the shell runs it after Hyprland
#                             reloads its config, which brings back Default's look)
#
# $XDG_RUNTIME_DIR/hyprdori-mode holds the mode (gone at logout, as the look is); it exists in
# Work and Game, as other scripts only check that.

# -h, --help: the comment above, then nothing else runs
case ${1:-} in -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac
set -euo pipefail

FLAG="${XDG_RUNTIME_DIR:-/tmp}/hyprdori-mode"

# Keyboard: the usual layouts and options, read from input.lua, and Game's
INPUT="$HOME/.config/hypr/configs/input.lua"
KB_LAYOUT=$(sed -n 's/^ *kb_layout = "\([^"]*\)".*/\1/p' "$INPUT" | head -n1)
KB_OPTIONS=$(sed -n 's/^ *kb_options = "\([^"]*\)".*/\1/p' "$INPUT" | head -n1)
GAME_KB_LAYOUT="us"
GAME_KB_OPTIONS="ctrl:nocaps"

# Border colors follow the current theme, and their width Settings (its generated theme.lua,
# as general.lua reads it)
borders="package.loaded['configs.generated.theme'] = nil
local ok, theme = pcall(require, 'configs.generated.theme')
local borders = ok and { active_border = theme.active_border, inactive_border = theme.inactive_border } or nil
local border_size = ok and theme.border_size or 2"

# The mode on the on-screen display, for a moment
osd() { "$HOME/.local/bin/hyprdori-osd" "$@"; }

current_mode() {
    if [[ -e $FLAG ]]; then
        local mode
        mode=$(<"$FLAG")
        echo "${mode:-work}"
    else
        echo default
    fi
}

style_on() {
    # every window opaque: there's no blur behind them
    hyprctl eval "$borders
hl.config({
    animations = { enabled = false },
    decoration = {
        blur = { enabled = false },
        active_opacity = 1,
        inactive_opacity = 1,
        rounding = 0,
    },
    general = {
        border_size = border_size,
        col = borders,
    },
})
" || true
    "$HOME/.local/bin/hyprdori-wallpaper" pause on 2>/dev/null || true
}

style_off() {
    # decoration.lua and animations.lua again (opacity, blur, animations), so their values
    # live in one place; the shell then sets the corners, blur and animations from Settings
    # (services/Hypr.qml)
    hyprctl eval "$borders
package.loaded['configs.decoration'] = nil
require('configs.decoration')
package.loaded['configs.animations'] = nil
require('configs.animations')
hl.config({
    general = {
        border_size = border_size,
        col = borders,
    },
})
" || true
    "$HOME/.local/bin/hyprdori-wallpaper" pause off 2>/dev/null || true
}

keyboard() {
    hyprctl eval "hl.config({ input = { kb_layout = '$1', kb_options = '$2' } })" >/dev/null
}

set_mode() {
    local target=$1 current
    current=$(current_mode)
    [[ $target == "$current" ]] && return

    if [[ $target == default ]]; then
        style_off
    elif [[ $current == default ]]; then
        style_on
    fi
    if [[ $target == game ]]; then
        keyboard "$GAME_KB_LAYOUT" "$GAME_KB_OPTIONS"
    elif [[ $current == game ]]; then
        keyboard "$KB_LAYOUT" "$KB_OPTIONS"
    fi

    if [[ $target == default ]]; then
        rm -f "$FLAG"
    else
        echo "$target" >"$FLAG"
    fi
    # Quickshell's look, gaps and Stay Awake
    qs ipc call theme mode "$target" >/dev/null 2>&1 || true

    case $target in
        work) osd modeWork "Work" ;;
        game) osd modeGame "Game" ;;
        default) osd modeDefault "Default" ;;
    esac
}

mode=$(current_mode)
case ${1:-work} in
    work) [[ $mode == work ]] && set_mode default || set_mode work ;;
    game) [[ $mode == game ]] && set_mode default || set_mode game ;;
    cycle)
        case $mode in
            default) set_mode work ;;
            work) set_mode game ;;
            *) set_mode default ;;
        esac
        ;;
    default) set_mode default ;;
    restyle) [[ $mode == default ]] || style_on ;;
    *)
        echo "usage: hyprdori-mode [work|game|cycle|default|restyle]" >&2
        exit 1
        ;;
esac
