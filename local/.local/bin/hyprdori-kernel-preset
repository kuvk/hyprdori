#!/usr/bin/env bash
# Moves a kernel installed later onto the boot menu. A kernel package's install writes the stock
# mkinitcpio preset, which puts the kernel and its image in /boot, where Limine can't read them
# (it reads only the ESP). This writes the preset install.sh writes (kernel and image in
# ESP/arch), copies the kernel there, builds the image, removes the copies in /boot, and writes
# the boot menu again (limine/install.sh, with the options it was installed with). Install the
# kernel's -headers package first where DKMS modules (NVIDIA's) must be built for it. With the
# ESP at /boot, the stock preset puts them on it already: only a preset that builds a unified
# kernel image instead (archinstall can set that up) is written, and its old image removed;
# else only the menu is written again.
#
#   hyprdori-kernel-preset            every installed kernel whose preset isn't Hyprdori's yet,
#                                     and the menu written again if a kernel on the ESP is
#                                     missing from it (a kernel reinstalled gets its old preset
#                                     back from pacman's .pacsave, so it's already there)
#   hyprdori-kernel-preset KERNEL...  these (package names: linux-zen, linux-g14, ...), again too
#
# Asks for the password (sudo). Each image is about 150 MB with NVIDIA's modules; it stops when
# the ESP lacks the room. Only with Hyprdori's boot menu (hyprdori-installed menu): another boot
# loader reads its kernels where they are.

# -h, --help: the comment above, then nothing else runs
case ${1:-} in -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;; esac
set -euo pipefail

hyprdori=$(cd "$(dirname "$(readlink -f "$0")")/../../.." && pwd)
installed=$hyprdori/local/.local/bin/hyprdori-installed
esp=$("$installed" --esp) || { echo "No EFI system partition mounted at /efi, /boot or /boot/efi" >&2; exit 1; }
kernels=$("$installed" --kernels)
conf=$esp/limine.conf

"$installed" menu ||
    { echo "No boot menu of Hyprdori's (Limine) here: kernels stay where the boot loader reads them." >&2; exit 1; }

# The kernel file of an installed kernel package, from its module folder's pkgbase
kernel_file() {
    local base
    for base in /usr/lib/modules/*/pkgbase; do
        [[ $(<"$base") == "$1" ]] && { echo "${base%/pkgbase}/vmlinuz"; return 0; }
    done
    return 1
}

if (($#)); then
    wanted=("$@")
else
    wanted=()
    for base in /usr/lib/modules/*/pkgbase; do
        name=$(<"$base")
        preset=/etc/mkinitcpio.d/$name.preset
        if [[ $kernels == /boot ]]; then
            # the stock preset's place, on the ESP already, unless it builds a unified kernel image
            grep -qsE '^[[:space:]]*default_uki=' "$preset" && wanted+=("$name")
        else
            grep -qs "^ALL_kver=\"$kernels/" "$preset" || wanted+=("$name")
        fi
    done
fi
# The kernels on the ESP with an image, and the menu's kernel entries (//name, not the
# Snapshots folder): hyprdori-update compares the same. Through sudo when the ESP is mounted
# for root only (archinstall's)
read_as=()
[[ -r $esp && -x $esp ]] || { sudo -v; read_as=(sudo); }
on_esp=$("${read_as[@]}" find "$kernels" -maxdepth 1 -name 'vmlinuz-*' -printf '%f\n' | sed 's/^vmlinuz-//' |
    while read -r k; do "${read_as[@]}" test -e "$kernels/initramfs-$k.img" && echo "$k"; done | sort | tr '\n' ' ')
in_menu=$("${read_as[@]}" sed -n 's|^//\([^/]\)|\1|p' "$conf" 2>/dev/null | grep -vx Snapshots | sort | tr '\n' ' ')
if ((${#wanted[@]} == 0)) && [[ $on_esp == "$in_menu" ]]; then
    echo "Every installed kernel is on the boot menu already."
    exit 0
fi
for name in "${wanted[@]}"; do
    kernel_file "$name" >/dev/null || { echo "$name: no such kernel installed (pacman -S $name)" >&2; exit 1; }
done

# Room on the ESP: about 200 MB a kernel (the kernel, an image with NVIDIA's modules)
free_mb=$(($(df --output=avail -k "$esp" | tail -1) / 1024))
need_mb=$((${#wanted[@]} * 200))
if ((free_mb < need_mb)); then
    echo "The ESP has ${free_mb} MB free, ${need_mb} MB needed for: ${wanted[*]}" >&2
    exit 1
fi

sudo -v
for name in "${wanted[@]+"${wanted[@]}"}"; do
    preset=/etc/mkinitcpio.d/$name.preset
    [[ -e $preset ]] && sudo cp -n "$preset" "$preset.bak"
    # its unified kernel images: they'd keep the old kernel from the next update on
    ukis=()
    [[ -e $preset ]] && mapfile -t ukis < <(sed -n -E 's/^[[:space:]]*[a-z]+_uki="?([^"]*)"?.*/\1/p' "$preset")
    sudo tee "$preset" >/dev/null <<EOF
# mkinitcpio preset for $name; the kernel and image go to the ESP (hyprdori-kernel-preset)
ALL_kver="$kernels/vmlinuz-$name"
PRESETS=('default')
default_image="$kernels/initramfs-$name.img"
EOF
    sudo install -D -m 0644 "$(kernel_file "$name")" "$kernels/vmlinuz-$name"
    sudo mkinitcpio -p "$name"
    # the stock preset's copies, unless that's where they go now (the ESP at /boot)
    [[ $kernels == /boot ]] ||
        sudo rm -f "/boot/vmlinuz-$name" "/boot/initramfs-$name.img" "/boot/initramfs-$name-fallback.img"
    ((${#ukis[@]} == 0)) || sudo rm -f "${ukis[@]}"
    echo "$name: kernel and image in $kernels"
done

# The menu again, so it lists them
if sudo grep -qs 'Written by limine/install.sh' "$conf"; then
    read -ra options <<<"$(sudo sed -n 's/^# Options: //p' "$conf")"
    sudo "$hyprdori/limine/install.sh" "${options[@]}"
else
    echo "No boot menu written by limine/install.sh; add the kernels to it yourself." >&2
fi
