#!/usr/bin/env python3
"""Lighter copies of videos for live wallpapers. With ffmpeg, as H.264, 2560 px wide at 30 fps, no
sound: each video in the source folder (and its subfolders), into the output folder under the
same name. A copy made before is made again. Settings by environment: TARGET_W, TARGET_FPS, CRF,
PRESET.

  hyprdori-convert-live-wallpapers --source-dir DIR [--out-dir DIR]
      --source-dir DIR   the videos to convert (.mp4, .webm, .mkv, .mov); they stay as they are
      --out-dir DIR      where the copies go: ~/.local/share/hyprdori/backgrounds/live by
                         default, which the wallpaper picker lists. Another folder is listed once
                         it's a "live" one in ~/.config/hyprdori/backgrounds.json; neither may
                         be the source folder or inside it
"""
import os
import subprocess
import sys
from pathlib import Path

HOME = Path(os.path.expanduser("~"))
LIVE_DIR = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "hyprdori/backgrounds/live"

TARGET_W = int(os.environ.get("TARGET_W", "2560"))
TARGET_FPS = int(os.environ.get("TARGET_FPS", "30"))

CRF = os.environ.get("CRF", "20")
PRESET = os.environ.get("PRESET", "veryfast")

EXTS = {".mp4", ".webm", ".mkv", ".mov"}

def convert_one(src: Path, dst: Path) -> None:
    dst.parent.mkdir(parents=True, exist_ok=True)

    vf = f"scale={TARGET_W}:-2,fps={TARGET_FPS}"

    cmd = [
        "ffmpeg",
        "-hide_banner",
        "-loglevel",
        "error",
        "-y",
        "-i",
        str(src),
        "-an",
        "-vf",
        vf,
        "-c:v",
        "libx264",
        "-preset",
        PRESET,
        "-crf",
        CRF,
        "-pix_fmt",
        "yuv420p",
        str(dst.with_suffix(".mp4")),
    ]
    subprocess.run(cmd, check=False)

def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print((__doc__ or "").strip())
        return 0 if args else 1
    dirs = {"--source-dir": None, "--out-dir": str(LIVE_DIR)}
    while args:
        flag = args.pop(0)
        if flag not in dirs or not args:
            print(f"Unknown or incomplete: {flag} (see --help)", file=sys.stderr)
            return 1
        dirs[flag] = args.pop(0)
    if dirs["--source-dir"] is None:
        print("--source-dir DIR is needed (see --help)", file=sys.stderr)
        return 1
    src_dir = Path(dirs["--source-dir"]).expanduser().resolve()
    out_dir = Path(dirs["--out-dir"]).expanduser().resolve()
    if not src_dir.is_dir():
        print(f"No such folder: {src_dir}", file=sys.stderr)
        return 1
    # the copies keep the originals' names: in the source folder they'd replace them
    if out_dir == src_dir or out_dir.is_relative_to(src_dir):
        print(f"The output folder can't be the source folder or inside it: {out_dir}", file=sys.stderr)
        return 1

    videos = sorted(p for p in src_dir.rglob("*") if p.is_file() and p.suffix.lower() in EXTS)
    if not videos:
        print(f"No videos found in: {src_dir}")
        return 0

    for src in videos:
        rel = src.relative_to(src_dir)
        print(f"Converting: {rel}")
        convert_one(src, out_dir / rel)

    print(f"Done. Output in: {out_dir}")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
